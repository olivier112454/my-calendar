# ---------------------------------------------------------------------------
# Dayflow — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Public URL of the app. Used to build OAuth redirect URIs and booking links.
APP_URL="http://localhost:3000"

# Product name shown throughout the UI (see src/config/app.ts).
NEXT_PUBLIC_APP_NAME="Dayflow"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any PostgreSQL connection string. For local development without installing
# PostgreSQL, run `npm run dev:db` — it starts an embedded PGlite server that
# speaks the PostgreSQL wire protocol on port 5432 and matches the URL below.
#
# The two parameters are for the embedded server only. `pgbouncer=true` stops
# Prisma relying on named prepared statements, which PGlite does not keep
# between connections; `connection_limit=5` leaves room for a CLI command to
# connect alongside the dev server. Against a real PostgreSQL instance you can
# drop both (keep pgbouncer=true if you actually run PgBouncer).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dayflow?connection_limit=5&pgbouncer=true"

# The connection migrations use. A pooler in transaction mode breaks Prisma
# Migrate, so this one must be direct. Locally it is the same embedded server;
# on Neon it is the connection string *without* `-pooler` in the hostname.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dayflow"


# ---------------------------------------------------------------------------
# Secrets — generate with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
# Signs and encrypts the session cookie.
AUTH_SECRET=""

# Encrypts OAuth refresh/access tokens at rest (AES-256-GCM).
# Changing this invalidates all stored provider tokens (users must reconnect).
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Google OAuth 2.0 — see README "Google Cloud setup"
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match exactly what is registered in the Google Cloud console.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# ---------------------------------------------------------------------------
# Development conveniences
# ---------------------------------------------------------------------------
# When "true", a password-less demo login is available on the landing page and
# calendar/mail providers fall back to deterministic sample data when Google is
# not connected. Never enable in production.
ALLOW_DEV_LOGIN="true"

# ---------------------------------------------------------------------------
# Web Push — notifications that arrive when the app is closed
# ---------------------------------------------------------------------------
# Optional: without these, reminders still appear inside the app, and the
# settings page says push is not configured rather than offering a dead switch.
# Generate a pair with:
#   node -e "const{createECDH}=require('node:crypto');const e=createECDH('prime256v1');e.generateKeys();console.log(e.getPublicKey().toString('base64url'));console.log(e.getPrivateKey().toString('base64url'))"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact address push services can reach if something misbehaves.
VAPID_SUBJECT="mailto:you@example.com"
